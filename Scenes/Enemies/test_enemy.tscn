[sub_resource type="Shader" id="Shader_av56g"]
code = "shader_type canvas_item;

uniform float lerp_percent : hint_range(0.0, 1.0) = 0.0;
uniform vec4 desired_colour : source_color = vec4(1.0, 0.0, 0.0, 1.0);

void fragment() {
    vec4 base_color = texture(TEXTURE, UV) * COLOR;

    base_color.rgb = mix(
        base_color.rgb,
        desired_colour.rgb,
        lerp_percent
    );

    COLOR = base_color;
}
"

